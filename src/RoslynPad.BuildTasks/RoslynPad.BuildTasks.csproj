<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Loaded into the SDK's MSBuild node, which runs on the runtime of the SDK pinned by the
         script's global.json — netstandard2.0 loads into any node the user can select, and the
         full Roslyn closure is copied next to the task so the node's assembly load context
         resolves it from here (the app's own Roslyn assemblies may be newer-TFM assets). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
